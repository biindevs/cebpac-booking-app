<IfModule mod_rewrite.c>
    RewriteEngine On
    # For Hostinger: Use / if app is in root, or /subfolder/ if in subfolder
    RewriteBase /
    
    # Redirect root URL to public/index.php
    RewriteRule ^$ public/index.php [L]
    
    # If the request is not a file or directory, route to public/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [L,QSA]
</IfModule>

# Enable directory browsing prevention
Options -Indexes
